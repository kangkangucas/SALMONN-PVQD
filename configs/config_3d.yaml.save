═══════════════════════════════════════════════════════════════════════════════

📊 GENERATION PARAMETERS EXPLAINED
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

max_new_tokens: 200
  → Maximum number of new tokens the model can generate
  → Prevents infinitely long outputs

num_beams: 4
  → Uses beam search with 4 beams
  → Explores multiple hypotheses for better quality

do_sample: False
  → Deterministic generation (no randomness)
  → Good for evaluation (reproducible results)

temperature: 1.0
  → No temperature scaling (deterministic)
  → Higher values = more random

top_p: 0.9
  → Nucleus sampling parameter
  → Only used if do_sample=True

repetition_penalty: 1.0
  → No penalty for repeating tokens
  → Higher values = discourage repetition


