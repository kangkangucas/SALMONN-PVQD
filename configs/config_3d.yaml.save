python3 << 'EOF'
import numpy as np
import pyloudnorm

# Test pyloudnorm usage
sr = 16000
meter = pyloudnorm.Meter(sr)

# Create test audio
test_audio = np.random.randn(sr).astype(np.float32)

# Test the correct way to use pyloudnorm
try:
    current_loudness = meter.integrated_loudness(test_audio)
    print(f"Current loudness: {current_loudness}")
    
    # Correct way: meter.normalize(audio, target_loudness)
    normalized = meter.normalize(test_audio, -20.0)
    print(f"✅ Normalized audio shape: {normalized.shape}")
    print(f"✅ Normalized audio dtype: {normalized.dtype}")
    print(f"✅ No NaN: {not np.isnan(normalized).any()}")
except Exception as e:
    print(f"❌ Error: {e}")
EOF

