━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

1. Augmentation 改变音频长度
   • Time Stretch 会改变音频长度
   • 这导致 spectrogram 形状改变

2. Spectrogram 形状必须一致
   • Batch 中所有样本的 spectrogram 形状必须一致
   • 否则 collater 函数会出现问题

3. 不要混合原始和增强的音频
   • 如果使用增强的音频，就使用增强的音频的 spectrogram
   • 不要混合使用原始和增强的 spectrogram

4. 修复的重要性
   • 正确处理 augmentation 对模型训练至关重要
   • 形状不一致会导致难以调试的问题


