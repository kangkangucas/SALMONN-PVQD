generate:
  max_new_tokens: 200        # Max tokens to generate
  num_beams: 4               # Beam search width
  do_sample: False           # Use greedy/beam search
  min_length: 1              # Minimum output length
  temperature: 1.0           # Randomness (1.0 = deterministic)
  top_p: 0.9                 # Nucleus sampling
  repetition_penalty: 1.0    # Penalty for repeating tokens
  length_penalty: 1.0        # Penalty for length


