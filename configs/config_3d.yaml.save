⚙️ CONFIGURATION EXAMPLES
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

Conservative:
  augmentation:
    enable: True
    prob: 0.3
    types: ["speed", "loudness"]

Moderate (Recommended):
  augmentation:
    enable: True
    prob: 0.5
    types: ["speed", "loudness", "crop", "noise"]

Aggressive:
  augmentation:
    enable: True
    prob: 0.7
    types: ["speed", "loudness", "crop", "noise", "reverb"]


📋 REQUIRED LIBRARIES
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

librosa       - Audio processing, time stretching
scipy         - Signal processing, convolution
soundfile     - Audio I/O (read/write WAV)
pyloudnorm    - Perceptual loudness normalization

Total: ~200-300 MB


