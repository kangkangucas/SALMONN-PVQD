📚 Pyloudnorm API 参考
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

1️⃣ 创建 Meter
  meter = pyln.Meter(sr)

2️⃣ 测量响度
  loudness = meter.integrated_loudness(audio)

3️⃣ 响度归一化 ✅ 正确方式
  normalized = pyln.normalize.loudness(audio, current_loudness, target_loudness)

4️⃣ 峰值归一化
  peak_normalized = pyln.normalize.peak(audio, target_peak)


