cd /Users/kangfang/work/research/Kang/Code/SALMONN && python -c "
import torch
import numpy as np
from models.beats.BEATs import BEATs, BEATsConfig

# Test the preprocess function with padding
config = BEATsConfig()
model = BEATs(config)

# Create test data: batch of 4 samples with different lengths
batch_size = 4
max_len = 160000
source = []
for i in range(batch_size):
    # Create samples with different lengths
    if i < 2:
        # Real samples
        sample = torch.randn(80000 + i * 10000)
    else:
        # Padding samples (all zeros)
        sample = torch.zeros(max_len)
    source.append(sample)

# Pad to same length
source = torch.nn.utils.rnn.pad_sequence(source, batch_first=True)
print(f'Source shape: {source.shape}')
print(f'Source dtype: {source.dtype}')

# Test preprocess
try:
    fbank = model.preprocess(source)
    print(f'Fbank shape: {fbank.shape}')
    print(f'Fbank dtype: {fbank.dtype}')
    print(f'Fbank has NaN: {torch.isnan(fbank).any()}')
    print(f'Fbank has Inf: {torch.isinf(fbank).any()}')
    print(f'Fbank min: {fbank.min()}, max: {fbank.max()}')
    print('✓ Preprocess test passed!')
except Exception as e:
    print(f'✗ Preprocess test failed: {e}')
    import traceback
    traceback.print_exc()
"

